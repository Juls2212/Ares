# Copy this file to .env before using the development database commands.
# Do not commit .env or replace these placeholders with production credentials.

ARES_POSTGRES_DB=ares_development
ARES_POSTGRES_USER=ares_development
ARES_POSTGRES_PASSWORD=replace-with-a-local-development-password
ARES_POSTGRES_PORT=5433

# This URL is for a future Electron Main database connection only; it is not exposed to Vite or the renderer.
# Percent-encode URL-special characters if you place them in ARES_POSTGRES_PASSWORD.
DATABASE_URL=postgresql://ares_development:replace-with-a-local-development-password@127.0.0.1:5433/ares_development
