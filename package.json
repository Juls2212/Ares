{
  "name": "ares-desktop",
  "version": "0.1.0",
  "description": "Ares desktop application technical foundation",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "npm run native:build && electron-forge start",
    "package": "npm run native:build && electron-forge package",
    "make": "npm run native:build && electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude manual-tests/**",
    "test:db": "vitest run --config vitest.database.config.ts",
    "test:assistant:live": "node -e \"if (process.env.ARES_LIVE_ASSISTANT_CHECK !== '1') { console.error('Set ARES_LIVE_ASSISTANT_CHECK=1 to allow a live OpenAI request.'); process.exit(1); }\" && vitest run --config vitest.assistant-live.config.ts",
    "build": "npm run typecheck && npm run native:build && electron-forge package",
    "native:build": "node ./node_modules/node-gyp/bin/node-gyp.js rebuild --directory native/atomic-no-replace --devdir=./.native-node-gyp-cache --target=44.4.0 --arch=x64 --dist-url=https://electronjs.org/headers",
    "test:native": "npm run native:build && vitest run tests/windows-atomic-move.integration.test.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps postgres",
    "db:config": "docker compose config --no-interpolate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.15.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "0.31.10",
    "electron": "44.4.0",
    "node-gyp": "12.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "openai": "^7.20.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
